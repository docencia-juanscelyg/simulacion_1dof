<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simulacion_1dof</name>
  <version>0.0.1</version>
  <description>Este paquete muestra un pequeño simulador de 1 grado de libertad</description>
  <maintainer email="juanscelyg@gmail.com">Juan S. Cely G.</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rclcpp</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  
  <depend>robot_state_publisher</depend>
  <depend>xacro</depend>
  
  <depend>joint_trajectory_controller</depend>
  <depend>rqt_joint_trajectory_controller</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>controller_manager</depend>
  
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>gz_ros2_control</depend>
  <depend>rviz2</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>sensor_msgs</depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
